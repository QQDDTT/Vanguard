# ==============================================================================
# Vanguard FBE 平台环境配置模板
# ==============================================================================

# 服务端口绑定 (默认 8080)
PORT=8080

# PostgreSQL 数据库连接 (本地 Docker 开发环境)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vanguard

# Google Gemini API Key (用于 Vanguard Agent 七维度推断与工具调用)
GEMINI_API_KEY=your_gemini_api_key_here

# GCP Cloud Storage 存储桶名称 (用于素材预签名直传)
GCS_BUCKET_NAME=vanguard-artifacts-ailab

# 鉴权模式开关 (true: 启用本地 Dev-Mock 模拟身份；false: 启用生产 Google IAP / Firebase Auth)
VANGUARD_AUTH_MOCK=true

# 日志输出级别 (trace, debug, info, warn, error)
RUST_LOG=info,vanguard=debug
